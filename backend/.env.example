# Silifton CRM — backend (copy to .env and fill in)
MONGODB_URI="mongodb+srv://USER:PASS@cluster0.example.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="silifton"

JWT_SECRET="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
JWT_EXPIRES_IN="7d"

# Encrypts the credentials vault at rest (AES-256-GCM). Optional — falls back to
# JWT_SECRET if unset. Set a dedicated key in production; rotating it makes
# existing stored secrets unreadable.
CREDENTIALS_KEY=

PORT=7011
NODE_ENV=development
CORS_ORIGIN="http://localhost:7010"
COOKIE_NAME="silifton_session"

# Cloudinary — cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL="cloudinary://KEY:SECRET@CLOUD_NAME"
CLOUDINARY_FOLDER="silifton"
UPLOAD_MAX_BYTES=10485760

# --- Public website (silifton.com) — served by this API since the merge ---
# Inquiry notifications via Resend (optional; leave blank to disable).
RESEND_API_KEY=
CONTACT_EMAIL=
FROM_EMAIL="Silifton <hello@silifton.com>"
# Own hostname, so referrals from the site itself count as Direct traffic.
WEBSITE_HOST=silifton.com

# --- Nimbus file storage (https://capi.tecsior.com) ---
# When NIMBUS_API_KEY is set, website image uploads (covers, avatars, hero) go to
# Nimbus instead of Cloudinary. Get the key from the Nimbus admin; never commit it.
NIMBUS_API_KEY=
NIMBUS_BASE_URL=https://capi.tecsior.com/api/v1
NIMBUS_FOLDER_ID=
